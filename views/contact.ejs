<%- include('partials/header') %>

<div class="page-header">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> <span>/</span> <span>Contact</span>
    </div>
    <h1>Contact TutorConnect Support</h1>
    <p>We are here to assist parents and teachers with any questions.</p>
  </div>
</div>

<div class="container py-5">
  <div class="contact-grid">
    <div class="contact-info-card">
      <h3>Get in Touch</h3>
      <p>Have a question about booking a demo or applying as an educator? Reach out to our academic support desk.</p>

      <div class="contact-item mt-4">
        <span class="c-icon">📍</span>
        <div>
          <strong>Headquarters:</strong>
          <p>TutorConnect Academic Services, Connaught Place, New Delhi - 110001</p>
        </div>
      </div>

      <div class="contact-item">
        <span class="c-icon">📞</span>
        <div>
          <strong>Helpline (WhatsApp):</strong>
          <p>+91 98765 43210 (9 AM - 8 PM IST)</p>
        </div>
      </div>

      <div class="contact-item">
        <span class="c-icon">📧</span>
        <div>
          <strong>Email Support:</strong>
          <p>support@tutorconnect.com / admin@tutorconnect.com</p>
        </div>
      </div>
    </div>

    <div class="contact-form-card">
      <h3>Send us a Message</h3>
      <form action="/contact" method="POST" class="mt-3">
        <div class="form-group">
          <label class="form-label">Your Name</label>
          <input type="text" name="name" class="form-control" required placeholder="e.g. Ramesh Kumar">
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">Phone Number</label>
            <input type="tel" name="phone" class="form-control" required placeholder="+91 98765 43210">
          </div>
          <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" required placeholder="ramesh@example.com">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">I am a</label>
          <select name="userType" class="form-control">
            <option value="parent">Parent looking for a tutor</option>
            <option value="tutor">Teacher inquiring about verification / Zoom interview</option>
            <option value="other">General inquiry</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Your Message</label>
          <textarea name="message" class="form-control" rows="4" required placeholder="Describe your query..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">
          Submit Message &rarr;
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
