<%- include('partials/header') %>

<div class="page-header about-header">
  <div class="container text-center">
    <div class="breadcrumb justify-center">
      <a href="/">Home</a> <span>/</span> <span>About</span>
    </div>
    <span class="section-tag mb-2">Our Mission & Values</span>
    <h1 class="page-title">About TutorConnect</h1>
    <p class="page-subtitle">Bridging the trust and safety gap in home tuition with 100% Zoom-screened educators and zero hidden agency markups.</p>
  </div>
</div>

<div class="container py-5">
  <div class="about-grid">
    <!-- Left column: Story & Mission -->
    <div class="about-content-col">
      <div class="about-story-card">
        <span class="section-tag">Why We Started</span>
        <h2 class="about-heading">Individualized Learning for Every Child, in Total Safety</h2>
        <p>
          At <strong>TutorConnect</strong>, we believe every child deserves individualized academic guidance in the comfort and safety of their home.
        </p>
        <p>
          Traditional tuition classifieds and neighborhood agencies often list unvetted tutors with inflated credentials. Parents are left guessing who is visiting their home. We founded TutorConnect to solve this with a <strong>mandatory Zoom Video Screening & Document Verification process</strong> conducted by experienced academic administrators.
        </p>
        <p>
          When you connect with a tutor on TutorConnect, you know they have passed our rigorous academic assessment, background vetting, and communication check.
        </p>
      </div>

      <!-- Stats Pill Grid -->
      <div class="about-stats-grid mt-4">
        <div class="about-stat-box">
          <div class="stat-number">100%</div>
          <div class="stat-title">Zoom Screened</div>
          <p class="stat-desc">Every tutor interviewed live by academic coordinators</p>
        </div>
        <div class="about-stat-box">
          <div class="stat-number">15 Min</div>
          <div class="stat-title">Pedagogy Evaluation</div>
          <p class="stat-desc">Live assessment of teaching skills & original degree verification</p>
        </div>
        <div class="about-stat-box">
          <div class="stat-number">0%</div>
          <div class="stat-title">Agent Markups</div>
          <p class="stat-desc">Direct parent-tutor communication with 100% transparent rates</p>
        </div>
      </div>
    </div>

    <!-- Right column: Core Values Box -->
    <div class="about-values-col">
      <div class="about-values-card">
        <div class="values-header">
          <span class="values-badge">Our Pillars</span>
          <h3>What Sets TutorConnect Apart</h3>
          <p class="text-muted">Built on trust, safety, and personalized student growth.</p>
        </div>

        <div class="val-list">
          <div class="val-item">
            <div class="val-icon-wrap">🛡️</div>
            <div class="val-text">
              <h4>Safety & Credential Guarantee</h4>
              <p>Live camera inspection of government photo ID, university degrees, and background credentials before any home visit.</p>
            </div>
          </div>

          <div class="val-item">
            <div class="val-icon-wrap">🎯</div>
            <div class="val-text">
              <h4>1-on-1 Personalized Pedagogy</h4>
              <p>Individualized lesson plans matching your child's learning pace, school curriculum (CBSE, ICSE, State), and weak subject areas.</p>
            </div>
          </div>

          <div class="val-item">
            <div class="val-icon-wrap">💰</div>
            <div class="val-text">
              <h4>Transparent & Direct Pricing</h4>
              <p>Tutors set their hourly and monthly fees openly. Parents pay teachers directly with no middlemen commissions or hidden surcharges.</p>
            </div>
          </div>

          <div class="val-item">
            <div class="val-icon-wrap">🎁</div>
            <div class="val-text">
              <h4>Risk-Free Doorstep Trial</h4>
              <p>Evaluate tutor-student chemistry and teaching style firsthand with a trial class before committing to long-term tuition.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom CTA Actions -->
  <div class="workflow-cta-banner mt-5">
    <div class="cta-inner-box">
      <h2>Join Thousands of Satisfied Families & Educators</h2>
      <p>Whether you're looking for an inspiring home tutor or you're a qualified teacher seeking students, TutorConnect is your verified home.</p>
      <div class="workflow-cta-buttons">
        <a href="/tutors" class="btn btn-primary btn-lg">Find a Verified Tutor 🔍</a>
        <a href="/tutor/register" class="btn btn-outline btn-lg">Apply as a Home Tutor 👨‍🏫</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
