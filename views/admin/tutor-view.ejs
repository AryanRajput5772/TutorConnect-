<%- include('../partials/header') %>

<div class="admin-detail-page-wrapper">
  <div class="container py-4">
    <!-- Top Breadcrumb & Status Navigation Bar -->
    <div class="admin-top-nav-bar glass-card">
      <div class="admin-nav-left">
        <a href="/admin/dashboard" class="btn btn-outline btn-sm">
          <span class="icon">&larr;</span> Back to Verification Queue
        </a>
        <div class="breadcrumb-trail">
          <span class="crumb-muted">Admin Console</span>
          <span class="crumb-sep">/</span>
          <span class="crumb-muted">Tutor Applications</span>
          <span class="crumb-sep">/</span>
          <span class="crumb-current"><%= tutor.name %></span>
        </div>
      </div>

      <div class="admin-nav-right">
        <% if (tutor.verificationStatus === 'verified') { %>
          <span class="status-pill status-verified">
            <span class="pulse-dot"></span> Verified & Live
          </span>
          <a href="/tutors/<%= tutor._id %>" class="btn btn-outline btn-sm" target="_blank">
            👁️ View Live Public Profile &rarr;
          </a>
        <% } else if (tutor.verificationStatus === 'interview_scheduled') { %>
          <span class="status-pill status-interview_scheduled">
            <span class="pulse-dot"></span> Interview Scheduled
          </span>
        <% } else if (tutor.verificationStatus === 'rejected') { %>
          <span class="status-pill status-rejected">
            <span class="pulse-dot"></span> Application Rejected
          </span>
        <% } else { %>
          <span class="status-pill status-pending">
            <span class="pulse-dot"></span> Pending Review
          </span>
        <% } %>
      </div>
    </div>

    <!-- 2-Column Responsive Cockpit Layout -->
    <div class="admin-detail-layout mt-4">
      <!-- LEFT COLUMN: Tutor Profile Dossier -->
      <div class="admin-detail-main">
        <!-- Main Profile Glass Card -->
        <div class="glass-card detail-box profile-dossier-card">
          <!-- Profile Header -->
          <div class="admin-profile-head">
            <div class="admin-avatar-frame">
              <img src="<%= tutor.avatar %>" alt="<%= tutor.name %>" class="admin-large-avatar" onerror="this.src='/images/default-avatar.svg'">
              <% if (tutor.verificationStatus === 'verified') { %>
                <span class="avatar-verified-badge" title="Verified Tutor">✓</span>
              <% } %>
            </div>

            <div class="admin-profile-meta">
              <div class="meta-status-row">
                <span class="dossier-id-badge">ID: <%= tutor._id.toString().slice(-6).toUpperCase() %></span>
                <% if (tutor.verificationStatus === 'verified') { %>
                  <span class="badge-status-tag tag-verified">✓ Verified Live</span>
                <% } else if (tutor.verificationStatus === 'interview_scheduled') { %>
                  <span class="badge-status-tag tag-scheduled">📹 Video Interview Booked</span>
                <% } else if (tutor.verificationStatus === 'rejected') { %>
                  <span class="badge-status-tag tag-rejected">✕ Application Rejected</span>
                <% } else { %>
                  <span class="badge-status-tag tag-pending">⏳ Needs Video Interview</span>
                <% } %>
              </div>

              <h1 class="admin-tutor-title"><%= tutor.name %></h1>
              <p class="admin-tutor-qual">
                <span class="qual-icon">🎓</span>
                <strong><%= tutor.qualification %></strong>
                <% if (tutor.college) { %>
                  <span class="qual-college">• <%= tutor.college %></span>
                <% } %>
              </p>

              <!-- Quick Contact Badges -->
              <div class="quick-contact-row mt-2">
                <a href="mailto:<%= tutor.email %>" class="contact-pill email-pill" title="Send direct email">
                  <span class="pill-icon">📧</span>
                  <span><%= tutor.email %></span>
                </a>
                <a href="tel:<%= tutor.phone %>" class="contact-pill phone-pill" title="Call or WhatsApp">
                  <span class="pill-icon">📞</span>
                  <span><%= tutor.phone %></span>
                </a>
                <span class="contact-pill location-pill" title="City of residence">
                  <span class="pill-icon">📍</span>
                  <span><%= tutor.city %></span>
                </span>
              </div>
            </div>
          </div>

          <!-- Fast Facts Grid: 4 Micro Glass Cards -->
          <div class="fast-facts-grid mt-4">
            <div class="fact-card">
              <span class="fact-icon">🏆</span>
              <div class="fact-info">
                <span class="fact-label">Experience</span>
                <strong class="fact-value"><%= tutor.experienceYears %> Years</strong>
              </div>
            </div>

            <div class="fact-card">
              <span class="fact-icon">💰</span>
              <div class="fact-info">
                <span class="fact-label">Hourly Fee</span>
                <strong class="fact-value">₹<%= tutor.hourlyFee %> <small>/ hr</small></strong>
              </div>
            </div>

            <div class="fact-card">
              <span class="fact-icon">💵</span>
              <div class="fact-info">
                <span class="fact-label">Monthly Fee</span>
                <strong class="fact-value">₹<%= tutor.monthlyFee || (tutor.hourlyFee * 12) %> <small>/ mo</small></strong>
              </div>
            </div>

            <div class="fact-card">
              <span class="fact-icon">🏫</span>
              <div class="fact-info">
                <span class="fact-label">Teaching Mode</span>
                <strong class="fact-value">
                  <%= tutor.teachingMode === 'home_tuition' ? 'Home Tuition' : (tutor.teachingMode === 'online' ? 'Online Classes' : 'Home & Online') %>
                </strong>
              </div>
            </div>
          </div>

          <hr class="glass-divider my-4">

          <!-- Academic & Teaching Details -->
          <div class="info-section">
            <div class="section-title-wrap">
              <span class="section-title-icon">📚</span>
              <h3 class="section-heading">Academic Credentials & Logistics</h3>
            </div>

            <div class="info-grid-2 mt-3">
              <div class="credential-box">
                <span class="cred-label">Highest Degree</span>
                <span class="cred-val"><%= tutor.qualification %></span>
              </div>

              <div class="credential-box">
                <span class="cred-label">College / University</span>
                <span class="cred-val"><%= tutor.college || 'Not specified' %></span>
              </div>

              <div class="credential-box">
                <span class="cred-label">Weekly Availability</span>
                <span class="cred-val"><%= tutor.availability || 'Weekdays & Weekends (Flexible)' %></span>
              </div>

              <div class="credential-box">
                <span class="cred-label">Application Submitted</span>
                <span class="cred-val"><%= new Date(tutor.createdAt).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
              </div>
            </div>
          </div>

          <!-- Subjects Taught -->
          <div class="info-section mt-4">
            <div class="section-title-wrap">
              <span class="section-title-icon">🎯</span>
              <h3 class="section-heading">Subjects Offered</h3>
            </div>
            <div class="subject-tags-large mt-2">
              <% if (tutor.subjects && tutor.subjects.length > 0) { %>
                <% tutor.subjects.forEach(subject => { %>
                  <span class="tag-pill-large">
                    <span class="tag-bullet">•</span> <%= subject %>
                  </span>
                <% }) %>
              <% } else { %>
                <span class="text-muted">No specific subjects listed</span>
              <% } %>
            </div>
          </div>

          <!-- Preferred Localities -->
          <div class="info-section mt-4">
            <div class="section-title-wrap">
              <span class="section-title-icon">📍</span>
              <h3 class="section-heading">Preferred Localities for Home Tuition</h3>
            </div>
            <div class="locality-chips-wrap mt-2">
              <% if (tutor.preferredLocations && tutor.preferredLocations.length > 0) { %>
                <% tutor.preferredLocations.forEach(loc => { %>
                  <span class="locality-chip">
                    <span class="pin-icon">📍</span> <%= loc %>
                  </span>
                <% }) %>
              <% } else { %>
                <span class="locality-chip">
                  <span class="pin-icon">📍</span> <%= tutor.city %> (All Areas)
                </span>
              <% } %>
            </div>
          </div>

          <!-- Teaching Philosophy & Bio -->
          <div class="info-section mt-4">
            <div class="section-title-wrap">
              <span class="section-title-icon">💬</span>
              <h3 class="section-heading">Teaching Philosophy & Bio</h3>
            </div>
            <div class="bio-glass-quote mt-2">
               
              <p class="bio-text"><%= tutor.bio || 'No personal bio submitted yet.' %></p>
          

            </div>
          </div>

          <!-- Zoom Interview Log Display (if scheduled or completed) -->
          <% if (tutor.interviewDetails && tutor.interviewDetails.zoomLink) { %>
            <div class="zoom-active-banner mt-4">
              <div class="zoom-banner-head">
                <div class="zoom-badge-icon">📹</div>
                <div>
                  <h4 class="zoom-banner-title">Scheduled Video Verification Call</h4>
                  <span class="zoom-banner-sub">
                    Status: <%= tutor.verificationStatus === 'verified' ? 'Interview Completed & Approved' : 'Interview Scheduled' %>
                  </span>
                </div>
              </div>

              <div class="zoom-details-grid mt-3">
                <div class="zoom-detail-item">
                  <span class="zoom-label">Meeting Room Link</span>
                  <div class="zoom-link-row">
                    <a href="<%= tutor.interviewDetails.zoomLink %>" target="_blank" class="zoom-link-anchor">
                      <%= tutor.interviewDetails.zoomLink %>
                    </a>
                  </div>
                </div>

                <div class="zoom-detail-item">
                  <span class="zoom-label">Scheduled Date & Time</span>
                  <strong class="zoom-date-val">
                    <%= tutor.interviewDetails.scheduledAt 
                        ? new Date(tutor.interviewDetails.scheduledAt).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) 
                        : 'Immediate / Pending confirmation' %>
                  </strong>
                </div>

                <% if (tutor.interviewDetails.meetingId) { %>
                  <div class="zoom-detail-item">
                    <span class="zoom-label">Meeting ID</span>
                    <code class="zoom-code"><%= tutor.interviewDetails.meetingId %></code>
                  </div>
                <% } %>

                <% if (tutor.interviewDetails.passcode) { %>
                  <div class="zoom-detail-item">
                    <span class="zoom-label">Passcode</span>
                    <code class="zoom-code"><%= tutor.interviewDetails.passcode %></code>
                  </div>
                <% } %>
              </div>

              <div class="zoom-banner-actions mt-3">
                <a href="<%= tutor.interviewDetails.zoomLink %>" target="_blank" class="btn btn-zoom btn-sm">
                  📹 Launch / Join Zoom Call Now &rarr;
                </a>
                <% if (tutor.interviewDetails.sentAt) { %>
                  <small class="zoom-sent-note">
                    Invitation dispatched: <%= new Date(tutor.interviewDetails.sentAt).toLocaleString() %>
                  </small>
                <% } %>
              </div>
            </div>
          <% } %>

          <!-- Admin Notes History (if any) -->
          <% if (tutor.adminNotes) { %>
            <div class="admin-notes-log mt-4">
              <div class="notes-log-head">
                <span class="notes-icon">📝</span>
                <strong>Recorded Admin Interview Notes:</strong>
              </div>
              <p class="notes-log-content"><%= tutor.adminNotes %></p>
            </div>
          <% } %>
        </div>

        <!-- Optional: Inquiries for this Tutor (if any exist) -->
        <% if (typeof inquiries !== 'undefined' && inquiries && inquiries.length > 0) { %>
          <div class="glass-card detail-box mt-4">
            <div class="section-title-wrap">
              <span class="section-title-icon">📩</span>
              <h3 class="section-heading">Parent Inquiries for <%= tutor.name %> (<%= inquiries.length %>)</h3>
            </div>
            <div class="inquiries-mini-list mt-3">
              <% inquiries.forEach(inq => { %>
                <div class="inquiry-mini-card">
                  <div class="inquiry-mini-head flex-between">
                    <strong><%= inq.parentName %> (<%= inq.parentPhone %>)</strong>
                    <span class="badge badge-light"><%= inq.studentGrade %></span>
                  </div>
                  <div class="inquiry-mini-body text-muted mt-1">
                    <span>📍 <%= inq.locality %></span> • <span>Subjects: <%= inq.subjectsNeeded.join(', ') %></span>
                  </div>
                  <% if (inq.message) { %>
                    <p class="inquiry-mini-msg mt-1">“<%= inq.message %>”</p>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <!-- RIGHT COLUMN: Interactive Admin Action Tower (Sticky) -->
      <div class="admin-detail-actions">
        <!-- STEP 1: Video Verification Card -->
        <div class="glass-card action-card zoom-action-card mb-4">
          <div class="action-card-header">
            <span class="step-indicator-pill step-blue">Step 1</span>
            <h3>📹 Send Zoom Interview Link</h3>
          </div>
          <p class="action-card-desc">
            Emails <%= tutor.name %> a direct video invitation with scheduled time & room credentials.
          </p>

          <form action="/admin/tutors/<%= tutor._id %>/send-zoom" method="POST" class="mt-3 action-form">
            <div class="form-group">
              <label class="form-label">Zoom Meeting Link *</label>
              <div class="input-icon-wrap">
                <input 
                  type="url" 
                  name="zoomLink" 
                  class="form-control" 
                  required 
                  placeholder="https://zoom.us/j/1234567890?pwd=xyz" 
                  value="<%= tutor.interviewDetails && tutor.interviewDetails.zoomLink ? tutor.interviewDetails.zoomLink : '' %>">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Interview Date & Time *</label>
              <% 
                let formattedScheduled = '';
                if (tutor.interviewDetails && tutor.interviewDetails.scheduledAt) {
                  try {
                    const d = new Date(tutor.interviewDetails.scheduledAt);
                    formattedScheduled = new Date(d.getTime() - (d.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
                  } catch (e) {}
                }
              %>
              <input 
                type="datetime-local" 
                name="scheduledAt" 
                class="form-control" 
                required 
                value="<%= formattedScheduled %>">
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Meeting ID</label>
                <input 
                  type="text" 
                  name="meetingId" 
                  class="form-control" 
                  placeholder="123 456 7890" 
                  value="<%= tutor.interviewDetails && tutor.interviewDetails.meetingId ? tutor.interviewDetails.meetingId : '' %>">
              </div>
              <div class="form-group">
                <label class="form-label">Passcode</label>
                <input 
                  type="text" 
                  name="passcode" 
                  class="form-control" 
                  placeholder="tc1234" 
                  value="<%= tutor.interviewDetails && tutor.interviewDetails.passcode ? tutor.interviewDetails.passcode : '' %>">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Candidate Instructions</label>
              <textarea name="notes" class="form-control" rows="2" placeholder="e.g. Please join on time with degree certificates ready."><%= tutor.interviewDetails && tutor.interviewDetails.notes ? tutor.interviewDetails.notes : 'Please have your academic degree certificates and ID proof ready for video verification.' %></textarea>
            </div>

            <button type="submit" class="btn btn-zoom btn-block btn-lg">
              🚀 <%= tutor.verificationStatus === 'interview_scheduled' ? 'Resend Updated Zoom Link' : 'Send Zoom Invitation Email' %>
            </button>
          </form>
        </div>

        <!-- STEP 2: Verification Decision Card -->
        <div class="glass-card action-card decision-action-card mb-4">
          <div class="action-card-header">
            <span class="step-indicator-pill step-green">Step 2</span>
            <h3>✅ Verification & Publishing</h3>
          </div>
          <p class="action-card-desc">
            Make the final decision after completing the 1-on-1 Zoom interview and reviewing credentials.
          </p>

          <% if (tutor.verificationStatus === 'verified') { %>
            <!-- Already Verified Notice -->
            <div class="verified-live-box mb-3">
              <div class="verified-live-icon">🎉</div>
              <div class="verified-live-text">
                <strong>Profile is Active & Verified!</strong>
                <p>This tutor is currently listed on the public homepage and search directory.</p>
                <% if (tutor.verifiedAt) { %>
                  <small>Verified on: <%= new Date(tutor.verifiedAt).toLocaleDateString() %></small>
                <% } %>
              </div>
            </div>
          <% } %>

          <form action="/admin/tutors/<%= tutor._id %>/verify" method="POST" class="mt-3" onsubmit="return confirm('Publish <%= tutor.name %> to the main TutorConnect website as a verified home tutor?');">
            <div class="form-group">
              <label class="form-label">Admin Assessment Notes (Optional)</label>
              <textarea 
                name="adminNotes" 
                class="form-control" 
                rows="3" 
                placeholder="e.g. Conducted Zoom interview on <%= new Date().toLocaleDateString() %>. Verified Master's degree and ID. Excellent subject fluency."><%= tutor.adminNotes || '' %></textarea>
            </div>

            <button type="submit" class="btn btn-success btn-block btn-lg glow-button">
              ✅ <%= tutor.verificationStatus === 'verified' ? 'Update & Re-verify Profile' : 'Verify & Publish Profile to Front Page' %>
            </button>
          </form>

          <% if (tutor.verificationStatus !== 'rejected') { %>
            <div class="reject-box-divider mt-4">
              <span>OR REJECT APPLICATION</span>
            </div>

            <form action="/admin/tutors/<%= tutor._id %>/reject" method="POST" class="mt-3" onsubmit="return confirm('Reject <%= tutor.name %>\'s tutor application?');">
              <input type="hidden" name="adminNotes" value="Application did not meet verification criteria during Zoom interview">
              <button type="submit" class="btn btn-ghost-danger btn-block">
                ✕ Reject Tutor Application
              </button>
            </form>
          <% } else { %>
            <div class="revert-box mt-3">
              <form action="/admin/tutors/<%= tutor._id %>/revert-pending" method="POST">
                <button type="submit" class="btn btn-outline btn-block btn-sm">
                  🔄 Revert Status to Pending Review
                </button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
