<%- include('partials/header') %>

<div class="page-header">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> <span>/</span> <span>How It Works</span>
    </div>
    <h1>How TutorConnect Works</h1>
    <p>Safety, Academic Excellence, and Total Transparency in Home Tuition.</p>
  </div>
</div>

<div class="container py-5">
  <!-- Parent workflow -->
  <div class="process-section">
    <div class="section-header text-center mb-5">
      <span class="section-tag">For Parents</span>
      <h2>Finding the Perfect Verified Tutor in 3 Simple Steps</h2>
    </div>

    <div class="step-cards-grid">
      <div class="step-card">
        <div class="step-num">Step 1</div>
        <h3>Search by Locality & Subject</h3>
        <p>Enter your neighborhood and your child's grade and subjects. Filter by hourly budget and tutor experience.</p>
      </div>

      <div class="step-card">
        <div class="step-num">Step 2</div>
        <h3>Check Verified Credentials</h3>
        <p>Review the tutor's verified qualifications, college degrees, subjects, and transparent hourly/monthly fees.</p>
      </div>

      <div class="step-card">
        <div class="step-num">Step 3</div>
        <h3>Request a Free Demo Class</h3>
        <p>Submit a home tuition request. The verified teacher contacts you to schedule an initial trial session at your doorstep.</p>
      </div>
    </div>
  </div>

  <!-- Tutor verification workflow -->
  <div class="process-section mt-5" id="interview">
    <div class="section-header text-center mb-5">
      <span class="section-tag">For Educators</span>
      <h2>Our 4-Stage Tutor Verification Protocol</h2>
      <p class="section-subtitle">Why parents trust TutorConnect: only top educators are approved.</p>
    </div>

    <div class="verification-deep-dive">
      <div class="deep-dive-item">
        <div class="dd-badge">1</div>
        <div class="dd-content">
          <h4>Online Profile & Credential Submission</h4>
          <p>Tutors create an account and detail their educational history, university degrees, subjects, fees, and preferred localities.</p>
        </div>
      </div>

      <div class="deep-dive-item highlight-dd">
        <div class="dd-badge">2</div>
        <div class="dd-content">
          <h4>Live Zoom Interview with Academic Admin</h4>
          <p>Our academic coordinator reviews the application on the Admin Dashboard and sends a Zoom meeting link via email. During the 15-minute video interview, we evaluate:</p>
          <ul>
            <li>Subject knowledge and pedagogy</li>
            <li>Communication skills and patience with children</li>
            <li>Original degree and ID proof verification on video</li>
            <li>Past track record and teaching references</li>
          </ul>
        </div>
      </div>

      <div class="deep-dive-item">
        <div class="dd-badge">3</div>
        <div class="dd-content">
          <h4>Admin Verification & Badge Grant</h4>
          <p>Upon satisfactory interview performance, the admin clicks "Verify" to award the verified badge and publish the profile live on the homepage.</p>
        </div>
      </div>

      <div class="deep-dive-item">
        <div class="dd-badge">4</div>
        <div class="dd-content">
          <h4>Direct Home Tuition Assignments</h4>
          <p>Parents in the tutor's preferred localities can book demo sessions and start 1-on-1 home tuitions immediately.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="text-center mt-5">
    <a href="/tutors" class="btn btn-primary btn-lg">Browse Verified Tutors Now</a>
    <a href="/tutor/register" class="btn btn-outline btn-lg ml-2">Apply as a Tutor</a>
  </div>
</div>

<%- include('partials/footer') %>
