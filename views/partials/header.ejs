<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'TutorConnect - Verified Home Tutors' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top announcement banner -->
  <div class="top-bar">
    <div class="container top-bar-content">
      <div class="top-bar-left">
        <span>🛡️ <strong>100% Verified Tutors:</strong> Every tutor is interviewed via Zoom & credential-checked before listing.</span>
      </div>
      <div class="top-bar-right">
        <a href="/contact">Need Assistance? Call: +91 98765 43210</a>
      </div>
    </div>
  </div>

  <!-- Navigation bar -->
  <header class="navbar">
    <div class="container navbar-container">
      <a href="/" class="brand-logo">
        <span class="brand-icon">🎓</span>
        <span class="brand-text">Tutor<span class="highlight">Connect</span></span>
      </a>

      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
        <span class="hamburger"></span>
      </button>

      <nav class="nav-links" id="navMenu">
        <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a>
        <a href="/tutors" class="nav-link <%= currentPath === '/tutors' ? 'active' : '' %>">Find Tutors</a>
        <a href="/how-it-works" class="nav-link <%= currentPath === '/how-it-works' ? 'active' : '' %>">How It Works</a>
        <a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>">About</a>

        <div class="nav-actions">
          <% if (isAdmin) { %>
            <a href="/admin/dashboard" class="btn btn-outline btn-sm">
              <span class="icon">🛡️</span> Admin Panel
            </a>
            <a href="/admin/inquiries" class="btn btn-outline btn-sm">
              <span class="icon">📩</span> Inquiries
            </a>
            <a href="/admin/logout" class="btn btn-secondary btn-sm">Logout</a>
          <% } else if (isTutor) { %>
            <a href="/tutor/dashboard" class="btn btn-primary btn-sm">
              <span class="icon">👨‍🏫</span> My Tutor Portal
            </a>
            <a href="/tutor/logout" class="btn btn-secondary btn-sm">Logout</a>
          <% } else { %>
            <a href="/tutor/login" class="btn btn-ghost btn-sm">Tutor Login</a>
            <a href="/tutor/register" class="btn btn-primary btn-sm">Join as a Tutor</a>
            <a href="/admin/login" class="nav-admin-link" title="Admin Portal">🛡️</a>
          <% } %>
        </div>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="container">
      <%- include('./alerts') %>
    </div>
