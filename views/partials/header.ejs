<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO Primary Meta Tags -->
  <title><%= typeof title !== 'undefined' ? title : 'TutorConnect - Find Trusted Home Tutors Near You' %></title>
  <meta name="title" content="<%= typeof title !== 'undefined' ? title : 'TutorConnect - Find Trusted Home Tutors Near You' %>">
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'TutorConnect helps parents find qualified home tutors for different subjects, classes and locations. Connect with the right tutor for your learning needs.' %>">
  <meta name="keywords" content="<%= typeof metaKeywords !== 'undefined' ? metaKeywords : 'home tutors, online tutors, home tuition, find tutors, private tutors, TutorConnect' %>">
  
  <!-- Robots & Search Engine Indexing -->
  <% if (typeof currentPath !== 'undefined' && (currentPath.startsWith('/admin') || currentPath.startsWith('/tutor/dashboard'))) { %>
    <meta name="robots" content="noindex, nofollow">
  <% } else { %>
    <meta name="robots" content="index, follow">
  <% } %>

  <!-- Canonical URL -->
  <link rel="canonical" href="https://tutorconnect.site<%= typeof currentPath !== 'undefined' && currentPath !== '/' ? currentPath : '' %>">

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://tutorconnect.site<%= typeof currentPath !== 'undefined' && currentPath !== '/' ? currentPath : '' %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'TutorConnect - Find Trusted Home Tutors Near You' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'TutorConnect helps parents find qualified home tutors for different subjects, classes and locations. Connect with the right tutor for your learning needs.' %>">
  <meta property="og:image" content="https://tutorconnect.site/images/default-avatar.svg">

  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'TutorConnect - Find Trusted Home Tutors Near You' %>">
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'TutorConnect helps parents find qualified home tutors for different subjects, classes and locations. Connect with the right tutor for your learning needs.' %>">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="alternate icon" href="/favicon.svg">

  <!-- Early Theme Hydration (Prevents Flash of Unstyled Theme) -->
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('tutorconnect_theme');
        if (savedTheme === 'black' || savedTheme === 'dark' || savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'black');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Fonts & Stylesheet -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Navigation bar -->
  <header class="navbar">
    <div class="navbar-container">
      <a href="/" class="brand-logo">
        <span class="brand-icon">🎓</span>
        <span class="brand-text">Tutor<span class="highlight">Connect</span></span>
      </a>

      <div class="navbar-controls">
        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
          <span class="hamburger"></span>
        </button>
      </div>

      <nav class="nav-links" id="navMenu">
        <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a>
        <a href="/tutors" class="nav-link <%= currentPath === '/tutors' ? 'active' : '' %>">Find Tutors</a>
        <a href="/how-it-works" class="nav-link <%= currentPath === '/how-it-works' ? 'active' : '' %>">How It Works</a>
        <a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>">About</a>
        <a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>

        <div class="nav-actions">
          <!-- Multi-Theme Switcher (Light / Midnight Blue / All-Black OLED) -->
          <div class="theme-switcher-wrapper" id="themeSwitcherWrapper">
            <button class="theme-toggle-btn" id="themeToggle" type="button" aria-label="Select website theme" title="Switch Theme (Light / Midnight Blue / All Black)">
              <!-- Light Mode Icon (Sun) -->
              <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
              <!-- Midnight Blue Icon (Crescent Moon) -->
              <svg class="theme-icon theme-icon-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
              <!-- All-Black OLED Icon (Solid Eclipse Sphere) -->
              <svg class="theme-icon theme-icon-black" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" fill="none"></circle>
                <path d="M12 3a9 9 0 0 0 0 18z"></path>
              </svg>
            </button>

            <!-- Theme Quick Selection Popover -->
            <div class="theme-dropdown-menu" id="themeDropdownMenu">
              <button type="button" class="theme-option-item" data-theme-val="light">
                <span class="theme-opt-icon">☀️</span>
                <span class="theme-opt-label">Pearl White</span>
                <span class="theme-opt-check">✓</span>
              </button>
              <button type="button" class="theme-option-item" data-theme-val="dark">
                <span class="theme-opt-icon">🌌</span>
                <span class="theme-opt-label">Astral Blue</span>
                <span class="theme-opt-check">✓</span>
              </button>
              <button type="button" class="theme-option-item" data-theme-val="black">
                <span class="theme-opt-icon">🌑</span>
                <span class="theme-opt-label">Obsidian Noir</span>
                <span class="theme-opt-check">✓</span>
              </button>
            </div>
          </div>
          <% if (isAdmin) { %>
            <a href="/admin/dashboard" class="btn btn-outline btn-sm">
              <span class="icon">🛡️</span> Admin Panel
            </a>
            <a href="/admin/inquiries" class="btn btn-outline btn-sm">
              <span class="icon">📩</span> Inquiries
            </a>
            <a href="/admin/logout" class="btn btn-secondary btn-sm">Logout</a>
          <% } else if (isTutor) { %>
            <a href="/tutor/dashboard" class="btn btn-primary btn-sm">
              <span class="icon">👨‍🏫</span> My Tutor Portal
            </a>
            <a href="/tutor/logout" class="btn btn-secondary btn-sm">Logout</a>
          <% } else { %>
            <a href="/tutor/login" class="btn btn-ghost btn-sm">Tutor Login</a>
            <a href="/tutor/register" class="btn btn-primary btn-sm">Join as a Tutor</a>
            <a href="/admin/login" class="nav-admin-link" title="Admin Portal">🛡️</a>
          <% } %>
        </div>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="container">
      <%- include('./alerts') %>
    </div>
