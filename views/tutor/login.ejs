<%- include('../partials/header') %>

<div class="auth-page-wrapper">
  <div class="container auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <span class="auth-badge">👨‍🏫 Tutor Portal</span>
        <h2>Welcome Back, Educator</h2>
        <p>Login to check your verification status, view your Zoom interview invitation, and manage home tuition inquiries.</p>
      </div>

      <form action="/tutor/login" method="POST" class="auth-form">
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input type="email" name="email" class="form-control" required placeholder="your.email@example.com">
        </div>

        <div class="form-group">
          <div class="flex-between">
            <label class="form-label" for="tutorPassword">Password</label>
          </div>
          <div class="password-input-wrapper">
            <input type="password" id="tutorPassword" name="password" class="form-control" required placeholder="••••••••">
            <button type="button" class="toggle-password-btn" aria-label="Show password" title="Show password" data-target="tutorPassword">
              <svg class="eye-icon eye-show" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg class="eye-icon eye-hide" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg mt-3">
          Login to Tutor Portal &rarr;
        </button>

        <div class="auth-footer-text">
          New tutor looking for students? <a href="/tutor/register">Apply for Verification</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
